{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/*.md",
      "!**/*.mdx",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.turbo",
      "!**/.npm-cache",
      "!**/.pnpm-store",
      "!**/build",
      "!**/coverage",
      "!**/.expo",
      "!**/.docusaurus",
      "!**/routeTree.gen.ts",
      "!**/pnpm-lock.yaml",
      "!apps/api/migrations/meta",
      "!deploy/helm/**/templates",
      "!assets/icon.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
