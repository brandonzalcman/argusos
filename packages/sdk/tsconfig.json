{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2024", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@argus/sdk": ["./src/index.ts"],
      "@argus/sdk/server": ["./src/server/plugin.ts"],
      "@argus/sdk/host": ["./src/host/index.ts"],
      "@argus/sdk/sandbox-runtime": ["./src/sandbox-runtime.ts"],
      "@argus/sdk/compiler": ["./src/sandbox/compile.ts"],
      "@argus/sdk/templates": ["./src/templates/index.ts"],
      "@argus/sdk/client": ["./src/client/create-client.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "templates/**/*.ts"]
}
