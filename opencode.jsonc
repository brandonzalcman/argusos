{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ────────────────────────────────────────────────────────────
  // Thinking model for the main (primary) agent. Kimi K3.1 Pro is kept
  // for UI work (ui-designer) so its allowance is not spent on planning.
  // Cheap models live on the
  // subagents in .opencode/agents/*.md. Check exact IDs with: opencode models
  "model": "opencode-go/gemini-4-argon",
  "small_model": "opencode-go/glm-5.3-flash",
  "default_agent": "orchestrator",

  // ── Built-in agents: point them at cheap models ───────────────────────
  "agent": {
    "build": { "model": "opencode-go/deepseek-v4-pro" },
    "plan": { "model": "opencode-go/gemini-4-argon" },
    "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    "explore": { "model": "opencode-go/gpt-6-luna" }
  },

  // ── Default permissions (agents can tighten these) ────────────────────
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r *": "ask",
      "del /s *": "deny",
      "rmdir /s *": "deny",
      "git push *": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "docker system prune*": "ask",
      "pnpm publish*": "deny",
      "npm publish*": "deny"
    }
  },

  // ── MCP servers ───────────────────────────────────────────────────────
  // Every enabled server adds its tool list to the context of every request,
  // so only docs lookup is on by default. Flip the others on when needed.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://argus_readonly:argus@localhost:5432/argus_dev"
      ],
      "enabled": false
    }
  },

  "autoupdate": true
}
